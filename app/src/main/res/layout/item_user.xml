<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginBottom="10dp"

    app:cardBackgroundColor="#151515"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#303030"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/rowContainer"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">


        <TextView
            android:id="@+id/txtNo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_number_circle"
            android:gravity="center"
            android:text="01"
            android:textColor="#CFCFCF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgUser"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:contentDescription="User"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_user"
            app:tint="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/txtName"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:text="User name"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/editName"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_edit_field"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="8dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/txtRole"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_role"
                    android:gravity="center"
                    android:minWidth="60dp"
                    android:paddingHorizontal="9dp"
                    android:text="USER"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtEmail"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:drawableStart="@drawable/ic_email_small"
                android:drawablePadding="6dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text="email@example.com"
                android:textColor="@color/text_color_detailinfo1"
                android:textSize="13sp" />



        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnSave"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Save"
                android:padding="8dp"
                android:src="@drawable/ic_save"
                android:visibility="invisible"
                app:tint="@null" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete"
                android:padding="8dp"
                android:src="@drawable/ic_delete"
                android:visibility="invisible"
                app:tint="@null" />

        </LinearLayout>

        <CheckBox
            android:id="@+id/checkSelect"

            android:layout_width="32dp"

            android:layout_height="32dp"

            android:buttonTint="@color/white"

            android:visibility="gone"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>