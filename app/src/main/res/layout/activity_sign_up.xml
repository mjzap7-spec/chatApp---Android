<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_black"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="28dp">


        <!-- ================================================= -->
        <!-- LOGO -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/tvLogoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="70dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:contentDescription="Company logo"
                android:src="@drawable/ic_logo_mark"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvLogoName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:lineSpacingMultiplier="0.82"
                android:text="digital\ngrading\ncompany"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_size_large"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ROLE -->
        <!-- ================================================= -->

        <!--
            Keep this because your current registration logic
            supports USER / MANAGER.

            We make it visually subtle.
        -->

        <RadioGroup
            android:id="@+id/roleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:gravity="center">

            <RadioButton
                android:id="@+id/rbUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:buttonTint="@color/white"
                android:text="User"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbManager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:buttonTint="@color/white"
                android:text="Manager"
                android:textColor="@color/white"
                android:textSize="14sp" />

        </RadioGroup>


        <!-- ================================================= -->
        <!-- FULL NAME -->
        <!-- ================================================= -->

        <com.example.test.ui.components.CustomInputView
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="64dp" />

        <com.example.test.ui.components.CustomInputView
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp" />

        <com.example.test.ui.components.CustomInputView
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp" />

        <com.example.test.ui.components.CustomInputView
            android:id="@+id/confirmPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp" />


        <!-- ================================================= -->
        <!-- COMPANY CODE -->
        <!-- ================================================= -->

        <com.example.test.ui.components.CustomInputView
            android:id="@+id/companyCodeInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="28dp"
            android:visibility="gone" />


        <!-- ================================================= -->
        <!-- DIVIDER -->
        <!-- ================================================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="70dp"
            android:layout_marginEnd="40dp"
            android:background="#34343A" />


        <!-- ================================================= -->
        <!-- CONTINUE -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="23dp"
            android:fontFamily="sans-serif"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/sign_up"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            app:backgroundTint="@color/color_main_button"
            app:cornerRadius="40dp"
            app:rippleColor="#553DFFFF" />


        <!-- ================================================= -->
        <!-- SIGN IN -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/toSignIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/toSignIn_text"
            android:textColor="#B0B0B6"
            android:textSize="@dimen/text_size_normal"
            android:clickable="true"
            android:focusable="true" />


        <!-- ================================================= -->
        <!-- TERMS -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/sign_up_bottom_text"
            android:textColor="#8A8A91"
            android:textSize="@dimen/text_size_small" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>